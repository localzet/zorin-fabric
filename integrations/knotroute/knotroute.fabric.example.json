{
  "identity_file": "identity.json",
  "listen": [
    "0.0.0.0:7447"
  ],
  "advertise": [],
  "peers": [],
  "services": [
    {
      "name": "http",
      "target": "127.0.0.1:8080",
      "description": "local development server",
      "allow": []
    }
  ],
  "forwards": [],
  "aliases": [],
  "proxy": {
    "socks": "127.0.0.1:9477",
    "http": "127.0.0.1:9478",
    "direct": true,
    "default_http_service": "http",
    "default_https_service": "https"
  },
  "dashboard": "127.0.0.1:8484",
  "routing": {
    "lsa_interval": "20s",
    "lsa_ttl": "90s",
    "max_hops": 16
  },
  "transport": {
    "mode": "auto",
    "direct_first": false,
    "fallback_direct": true,
    "endpoints": [
      {
        "name": "zorin-fabric-vconnect",
        "type": "socks5",
        "endpoint": "127.0.0.1:1080",
        "priority": 10,
        "enabled": true
      }
    ]
  }
}
